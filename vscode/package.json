{
    "name": "calm-lang",
    "displayName": "CALM Language Support",
    "description": "VSCode support for CALM",
    "version": "0.1.0",
    "publisher": "las-r",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/las-r/calm.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "calm",
                "aliases": [
                    "CALM",
                    "Calm",
                    "calm"
                ],
                "extensions": [
                    ".cal"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "calm",
                "scopeName": "source.calm",
                "path": "./syntaxes/calm.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "code-runner.executorMap": {
                "calm": "calm run $fullFileName"
            }
        }
    }
}