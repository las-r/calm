;use io

// prime checker example in calm
// by las-r

def i32 main() {
    u64 n
    u64 i = 2

    printf("Enter n: ")
    scanf("%llu", @n)

    if n < 2 {
        printf("Not prime\n")
        return 0
    }

    while i * i <= n {
        if n % i == 0 {
            printf("Not prime\n")
            return 0
        }

        i = i + 1
    }

    printf("Prime\n")
    return 0
}