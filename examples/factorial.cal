extc def i32 printf([u8] f, ...)
extc def i32 scanf([u8] f, ...)

def u64 factorial(u64 n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

def i32 main() {
    u64 n
    printf("Enter n for n!: ")
    scanf("%lld", @n)
    printf("n! = %llu\n", factorial(n))
    return 0
}