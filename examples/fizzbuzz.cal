;use io

// fizzbuzz example in calm
// by las-r

def i32 main() {
    i32 i = 1

    while i <= 100 {
        if i % 15 == 0 {
            printf("FizzBuzz\n")
        } else if i % 3 == 0 {
            printf("Fizz\n")
        } else if i % 5 == 0 {
            printf("Buzz\n")
        } else {
            printf("%d\n", i)
        }

        i = i + 1
    }

    return 0
}