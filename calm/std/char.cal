def i32 isdigit(u8 c) { return c >= `0 && c <= `9 }
def i32 isupper(u8 c) { return c >= `A && c <= `Z }
def i32 islower(u8 c) { return c >= `a && c <= `z }
def i32 isalpha(u8 c) { return isupper(c) || islower(c) }
def i32 isalnum(u8 c) { return isalpha(c) || isdigit(c) }
def i32 isspace(u8 c) { return c == 32 || c == 9 || c == 10 || c == 13 }
def u8 toupper(u8 c) { if islower(c) { return c - 32 } return c }
def u8 tolower(u8 c) { if isupper(c) { return c + 32 } return c }