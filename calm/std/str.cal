def i64 strlen([u8] s) {
    i64 i = 0
    while s:i != 0 {
        i = i + 1
    }
    return i
}

def i32 strcmp([u8] a, [u8] b) {
    i64 i = 0
    while a:i == b:i {
        if a:i == 0 {
            return 0
        }
        i = i + 1
    }
    return a:i - b:i
}

def [u8] strcpy([u8] dest, [u8] src) {
    i64 i = 0
    while src:i != 0 {
        dest:i = src:i
        i = i + 1
    }
    dest:i = 0
    return dest
}

def [u8] strcat([u8] dest, [u8] src) {
    i64 n = strlen(dest)
    i64 i = 0
    while src:i != 0 {
        dest:(n + i) = src:i
        i = i + 1
    }
    dest:(n + i) = 0
    return dest
}